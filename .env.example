# Server
PORT=3000

# How often to check each site, in minutes
CHECK_INTERVAL_MINUTES=5

# How long to wait for a site to respond before marking it down (ms)
REQUEST_TIMEOUT_MS=10000

# How many consecutive failed checks before we call it "down"
# (avoids false alarms from one-off network blips)
FAILURE_THRESHOLD=2

# --- Kathir Technologies WhatsApp API ---
WHATSAPP_API_SECRET=your_api_secret_here
WHATSAPP_ACCOUNT=your_whatsapp_account_unique_id

# Recipient WhatsApp number(s), comma separated (e.g. +8801725844744)
WHATSAPP_TO=+8801725844744

# --- Email Notifications (SMTP / Postfix / Gmail) ---
# For local postfix on the server: host 127.0.0.1, port 25, no auth needed.
# For external SMTP (Gmail, Zoho, etc.): host smtp.gmail.com, port 587 or 465.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="Uptime Monitor" <alerts@creationwave.com>
EMAIL_TO=tanoy.sakib@gmail.com

# Report schedule (cron syntax, server's local timezone)
DAILY_REPORT_CRON=0 8 * * *
WEEKLY_REPORT_CRON=0 8 * * 1
MONTHLY_REPORT_CRON=0 8 1 * *

# --- Optional: UptimeRobot webhook ---
# If set, incoming webhooks must include ?secret=THIS_VALUE in the URL,
# so randoms can't POST fake "down" events at your server.
UPTIMEROBOT_WEBHOOK_SECRET=replace-with-a-random-string

# --- Dashboard login (required) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional
# TIMEZONE=Asia/Dhaka
# DOWN_REMINDER_MINUTES=60   # re-alert while a site stays down (0 = off)
# SSL_WARN_DAYS=14           # warn when an SSL certificate is this close to expiring
# HOST=127.0.0.1            # bind address (use 127.0.0.1 behind a reverse proxy)
